# Образец конфигурации. Скопируйте в .env: cp .env.example .env
# Значения ниже подходят только для локального демо, в реальной среде их нужно заменить.

# Порты на хосте
FRONTEND_PORT=3000
BACKEND_PORT=8081

# База данных
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=change-me-local-only

# Профиль Spring: demo засевает синтетические данные при первом старте
SPRING_PROFILES_ACTIVE=demo

# Аутентификация (секрет не короче 32 символов)
JWT_SECRET=local-demo-secret-change-me-0123456789abcdef
JWT_TTL_MINUTES=60

# Ключевая ставка, %. Заглушка: перед сдачей подставить актуальное значение
KEY_RATE_PERCENT=15.0

# Пауза между шагами конвейера, мс (чтобы смену статусов было видно на демо)
PIPELINE_STEP_DELAY_MS=800

# Имитация задержки внешних источников (моков), мс
MOCK_LATENCY_MS=200

# Имитация сбоя внешних источников: REGISTRY, BUREAU, TAX через запятую (пусто — все работают)
MOCK_UNAVAILABLE_SOURCES=

# Срок обработки задачи андеррайтером, часов
TASK_SLA_HOURS=4

# Защита от подбора пароля: неудачных попыток входа за окно, минут
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Формат логов backend: ecs (JSON) или пусто для обычного текста
LOG_FORMAT=ecs

# Источники, с которых браузер может обращаться к API (при смене FRONTEND_PORT поменяйте и здесь)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Память JVM
JAVA_OPTS=-Xms128m -Xmx512m
